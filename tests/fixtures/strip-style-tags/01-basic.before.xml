    <item>
        <title>Word-paste Mso stylesheet block is stripped</title>
        <link>https://news.uams.edu/2006/sample-st-a/</link>
        <content:encoded><![CDATA[<style>
p.MsoNormal, li.MsoNormal, div.MsoNormal {mso-style-parent:""; margin:0in; margin-bottom:.0001pt; font-size:12.0pt; font-family:"Times New Roman"; color:windowtext;}
</style>
<p>The body copy survives.</p>]]></content:encoded>
    </item>
    <item>
        <title>Plain CSS style block is stripped</title>
        <link>https://news.uams.edu/2010/sample-st-b/</link>
        <content:encoded><![CDATA[<style>
    p span.cutline {
        color: #88888b;
    }
</style>
<p>Cutline below the image.</p>]]></content:encoded>
    </item>
    <item>
        <title>Uppercase STYLE tag is stripped</title>
        <link>https://news.uams.edu/2010/sample-st-c/</link>
        <content:encoded><![CDATA[<STYLE>.foo{color:red}</STYLE><p>after</p>]]></content:encoded>
    </item>
    <item>
        <title>Style with attributes is stripped</title>
        <link>https://news.uams.edu/2010/sample-st-d/</link>
        <content:encoded><![CDATA[<style type="text/css" media="all">body { font-family: sans-serif; }</style><p>after</p>]]></content:encoded>
    </item>
    <item>
        <title>Content without a style block is unchanged</title>
        <link>https://news.uams.edu/2010/sample-st-e/</link>
