    <item>
        <title>Anchor around img inside attributed caption is unwrapped</title>
        <link>https://news.uams.edu/sample-anchor-a/</link>
        <content:encoded><![CDATA[[caption id="" align="alignleft"]<a href="https://news.uams.edu/wp-content/uploads/2017/03/IMG_6756-edited.jpg" rel="attachment wp-att-33944"><img src="https://news.uams.edu/wp-content/uploads/2017/03/IMG_6756-edited-209x300.jpg" alt="Mehaffey standing outside neurology clinic"></a> Mehaffey was inspired to go into medicine when her older sister was diagnosed with multiple sclerosis.[/caption]]]></content:encoded>
    </item>
    <item>
        <title>Anchor around img inside bare caption is unwrapped</title>
        <link>https://news.uams.edu/sample-anchor-b/</link>
        <content:encoded><![CDATA[[caption]<a href="https://example.com/full.jpg"><img src="https://example.com/thumb.jpg" alt="A"></a> Caption text.[/caption]]]></content:encoded>
    </item>
    <item>
        <title>Anchor around img OUTSIDE a caption is preserved</title>
        <link>https://news.uams.edu/sample-anchor-c/</link>
        <content:encoded><![CDATA[<p>Click <a href="https://example.com/full.jpg"><img src="https://example.com/thumb.jpg" alt="thumb"></a> to enlarge.</p>]]></content:encoded>
    </item>
    <item>
        <title>Anchor with non-img content inside caption is preserved</title>
        <link>https://news.uams.edu/sample-anchor-d/</link>
        <content:encoded><![CDATA[[caption]<a href="https://example.com">link text</a> with <a href="https://example.com/full.jpg"><img src="https://example.com/thumb.jpg" alt="A"></a> img link.[/caption]]]></content:encoded>
    </item>
    <item>
        <title>Multiple sequential captions each have their anchor unwrapped</title>
        <link>https://news.uams.edu/sample-anchor-e/</link>
        <content:encoded><![CDATA[[caption id="x" align="alignleft"]<a href="https://example.com/full1.jpg"><img src="https://example.com/thumb1.jpg" alt="A"></a> First.[/caption]
[caption id="y" align="alignright"]<a href="https://example.com/full2.jpg"><img src="https://example.com/thumb2.jpg" alt="B"></a> Second.[/caption]]]></content:encoded>
    </item>
    <item>
        <title>Anchor inside caption that's inside a paragraph is still unwrapped</title>
        <link>https://news.uams.edu/sample-anchor-f/</link>
        <content:encoded><![CDATA[<p>Lead text. [caption]<a href="https://example.com/full.jpg"><img src="https://example.com/thumb.jpg" alt="A"></a> Caption.[/caption] Trailing text.</p>]]></content:encoded>
    </item>
    <item>
        <title>Anchor between two adjacent captions outside the inner one is preserved</title>
        <link>https://news.uams.edu/sample-anchor-g/</link>
        <content:encoded><![CDATA[[caption]<img src="a.jpg" alt="A"> Inside.[/caption]<a href="https://example.com"><img src="https://example.com/x.jpg" alt="X"></a>[caption]<img src="b.jpg" alt="B"> Inside.[/caption]]]></content:encoded>
    </item>
