    <item>
        <title>td with img + br + text becomes bare caption inside td (Path F)</title>
        <link>https://news.uams.edu/sample-cic-pf-a/</link>
        <content:encoded><![CDATA[<table><tbody><tr><td><img class="img_style_1" alt="The Energizer spa will stop in 20 cities this year." src="https://uamshealth.com/upload/images/Newsroom/Features/health2008/bunny-breast-cancer.jpg"><br>The Energizer spa will stop in 20 cities this year.</td></tr></tbody></table>]]></content:encoded>
    </item>
    <item>
        <title>td with no br is not matched</title>
        <link>https://news.uams.edu/sample-cic-pf-b/</link>
        <content:encoded><![CDATA[<table><tbody><tr><td><img src="b.jpg" alt="B"> Inline caption.</td></tr></tbody></table>]]></content:encoded>
    </item>
    <item>
        <title>td with img + br + img is not matched</title>
        <link>https://news.uams.edu/sample-cic-pf-c/</link>
        <content:encoded><![CDATA[<table><tbody><tr><td><img src="c1.jpg" alt="C1"><br><img src="c2.jpg" alt="C2"></td></tr></tbody></table>]]></content:encoded>
    </item>
    <item>
        <title>td with empty text after br is not matched</title>
        <link>https://news.uams.edu/sample-cic-pf-d/</link>
        <content:encoded><![CDATA[<table><tbody><tr><td><img src="d.jpg" alt="D"><br>   </td></tr></tbody></table>]]></content:encoded>
    </item>
    <item>
        <title>Multi-row table with img+br+text cells each converts (Path F per cell)</title>
        <link>https://news.uams.edu/sample-cic-pf-e/</link>
        <content:encoded><![CDATA[<table><tbody><tr><td><img src="e1.jpg" alt="E1"><br>One.</td></tr><tr><td><img src="e2.jpg" alt="E2"><br>Two.</td></tr></tbody></table>]]></content:encoded>
    </item>
    <item>
        <title>td containing p align=right with img+br+text is captionized via Path E first</title>
        <link>https://news.uams.edu/sample-cic-pf-f/</link>
        <content:encoded><![CDATA[<table align="right"><tbody><tr><td><p align="right"><img class="img_style_1" alt="AHA Board Chairman" src="https://example.com/wilson-award.jpg"><br>AHA Board Chairman text.</p></td></tr><tr><td><p align="right"><img class="img_style_1" alt="UAMS Chancellor" src="https://example.com/wilson-award-uams.jpg"><br>UAMS Chancellor text.</p></td></tr></tbody></table>]]></content:encoded>
