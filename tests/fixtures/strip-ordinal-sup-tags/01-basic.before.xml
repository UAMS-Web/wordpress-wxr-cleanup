    <item>
        <title>Ordinal st nd rd th after digits unwraps</title>
        <link>https://news.uams.edu/sample-sup-a/</link>
        <content:encoded><![CDATA[<p>The 1<sup>st</sup>, 2<sup>nd</sup>, 3<sup>rd</sup>, 4<sup>th</sup> place finishers.</p>]]></content:encoded>
    </item>
    <item>
        <title>Uppercase ordinal still unwraps</title>
        <link>https://news.uams.edu/sample-sup-b/</link>
        <content:encoded><![CDATA[<p>Little Rock was the 17<SUP>TH</SUP> city.</p>]]></content:encoded>
    </item>
    <item>
        <title>Sup not preceded by digit is left alone</title>
        <link>https://news.uams.edu/sample-sup-c/</link>
        <content:encoded><![CDATA[<p>Footnote<sup>1</sup>: details. And x<sup>n</sup> = y.</p>]]></content:encoded>
    </item>
    <item>
        <title>Sup with non-ordinal text is left alone</title>
        <link>https://news.uams.edu/sample-sup-d/</link>
        <content:encoded><![CDATA[<p>The molecule O<sup>2+</sup> is reactive.</p>]]></content:encoded>
    </item>
    <item>
        <title>Sup with multi-digit prefix unwraps</title>
        <link>https://news.uams.edu/sample-sup-e/</link>
        <content:encoded><![CDATA[<p>The 2026<sup>th</sup> edition.</p>]]></content:encoded>
    </item>
    <item>
        <title>Sup at start of paragraph (no preceding char) is left alone</title>
