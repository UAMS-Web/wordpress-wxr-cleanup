    <item>
        <title>http youtube embed with id and trailing extras converts to canonical watch URL</title>
        <link>https://news.uams.edu/sample-cye-a/</link>
        <content:encoded><![CDATA[<embed src="http://www.youtube.com/v/wc3wToFuBww&hl=en&fs=1&rel=0" width="425" height="344" type="application/x-shockwave-flash" allowfullscreen="true" allowscriptaccess="always" />]]></content:encoded>
    </item>
    <item>
        <title>https youtube embed with hyphenated id converts</title>
        <link>https://news.uams.edu/sample-cye-b/</link>
        <content:encoded><![CDATA[<embed src="https://www.youtube.com/v/-Iv68u0j6eg&hl=en&fs=1&rel=0" width="320" height="265" type="application/x-shockwave-flash" allowscriptaccess="always" allowfullscreen="true" />]]></content:encoded>
    </item>
    <item>
        <title>Non-youtube embed is left alone</title>
        <link>https://news.uams.edu/sample-cye-c/</link>
        <content:encoded><![CDATA[<embed src="http://example.com/foo.swf" width="425" height="344" />]]></content:encoded>
    </item>
    <item>
        <title>Embed with no src is left alone</title>
        <link>https://news.uams.edu/sample-cye-d/</link>
        <content:encoded><![CDATA[<embed width="425" height="344" />]]></content:encoded>
    </item>
    <item>
        <title>Two youtube embeds in a row convert independently</title>
        <link>https://news.uams.edu/sample-cye-e/</link>
        <content:encoded><![CDATA[<embed src="http://www.youtube.com/v/aaa111" /><embed src="http://www.youtube.com/v/bbb222" />]]></content:encoded>
    </item>
    <item>
        <title>Youtube embed inside a paragraph is converted in place</title>
        <link>https://news.uams.edu/sample-cye-f/</link>
        <content:encoded><![CDATA[<p>Watch: <embed src="http://www.youtube.com/v/ccc333" /> here.</p>]]></content:encoded>
